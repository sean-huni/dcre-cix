<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- SCRUM-55: correlate each reply verdict to the CRW emission batch that carried
         its e2e (crw_emission.outbound_msg_id, Task 1). NULL when CRW's registry does
         not know the OrgnlMsgId (fail-open ingest, fail-closed correlation). -->
    <changeSet id="003-isr-emission-fk" author="dcre">
        <preConditions onFail="MARK_RAN"><not><columnExists tableName="isr_resp" columnName="emission_id"/></not></preConditions>
        <addColumn tableName="isr_resp"><column name="emission_id" type="UUID"/></addColumn>
        <createIndex tableName="isr_resp" indexName="ix_isr_emission"><column name="emission_id"/></createIndex>
    </changeSet>

</databaseChangeLog>
